{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opiu.local/schemas/r001_handoff.schema.json",
  "title": "OPIU R001 Handoff",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "source_r005_run_id",
    "organization",
    "period",
    "reconciliation",
    "rules",
    "applications"
  ],
  "properties": {
    "schema_version": { "const": "opiu-r001-handoff.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "source_r005_run_id": { "type": "string", "minLength": 1 },
    "organization": {
      "type": "object",
      "required": ["id", "name", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "include_descendants": { "type": "boolean" }
      }
    },
    "period": { "type": "string", "minLength": 1 },
    "reconciliation": {
      "type": "object",
      "required": ["path", "sha256", "codex_input_path", "codex_input_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "codex_input_path": { "type": "string", "minLength": 1 },
        "codex_input_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "rules": {
      "type": "object",
      "required": ["path", "sha256", "rules_revision_set_hash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "rules_revision_set_hash": { "type": "string", "minLength": 1 }
      }
    },
    "applications": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "structural_control_proof": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "settings_binding_sha256",
        "control_results_sha256",
        "structural_control_proof_sha256",
        "set_count",
        "control_result_count",
        "applied_version_ids",
        "report_only",
        "financial_rows",
        "posting_rows"
      ],
      "properties": {
        "schema_version": { "const": "opiu-structural-control-proof.v1" },
        "settings_binding_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "control_results_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "structural_control_proof_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "set_count": { "type": "integer", "minimum": 0 },
        "control_result_count": { "type": "integer", "minimum": 0 },
        "applied_version_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "report_only": { "const": true },
        "financial_rows": { "const": 0 },
        "posting_rows": { "const": 0 },
        "correction_authority": { "const": false },
        "execution_allowed": { "const": false }
      }
    }
  }
}
